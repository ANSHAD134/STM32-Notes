#include "stm32f446xx.h"
#include "stm32f446xx_i2c_driver.h"
#include "bmp280.h"

// Calibration variables from BMP280
uint16_t dig_T1;
int16_t dig_T2, dig_T3;
int32_t t_fine;
int32_t adc_T;
float adc_Tf;
float var1, var2, T;

void BMP280_Init(I2C_Handle_t *pI2CHandle)
{
	for(uint32_t i = 0; i < 500000; i++);						// Wait sensor to power up

	uint8_t config[2];

	BMP280_readCalibration();									// Read all calibration values

	config[0] = 0xF4;											// CTRL_MEAS register
	config[1] = 0x23;											// Temp Configuration

	I2C_MasterSendData(pI2CHandle, config, 2, BMP280_ADDR, I2C_DISABLE_SR);
}

uint16_t BMP280_Read16(I2C_Handle_t *pI2CHandle, uint8_t reg)
{
	uint8_t data[2];

	I2C_MasterSendData(pI2CHandle, &reg, 1, BMP280_ADDR, I2C_ENABLE_SR);

	I2C_MasterReceiveData(pI2CHandle, data, 2, BMP280_ADDR, I2C_DISABLE_SR);

	return ((uint16_t)data[1] << 8) | data[0];
}

void BMP280_readCalibration(I2C_Handle_t *pI2CHandle)
{
	dig_T1 = BMP280_Read16(pI2CHandle, 0x88);					// Temperature 1
	dig_T2 = (int16_t)BMP280_Read16(pI2CHandle, 0x8A);			// Temperature 2
	dig_T3 = (int16_t)BMP280_Read16(pI2CHandle, 0x8C);			// Temperature 3
}


float BMP280_ReadTemperature(I2C_Handle_t *pI2CHandle)
{
	uint8_t reg = BMP280_TEMP_MSB_REG;
	uint8_t data[3];

	I2C_MasterSendData(pI2CHandle, &reg, 1, BMP280_ADDR, I2C_ENABLE_SR);

	I2C_MasterReceiveData(pI2CHandle, data, 3, BMP280_ADDR, I2C_DISABLE_SR);

	adc_T = ((int32_t) data[0] << 12) | ((int32_t) data[1] << 4) | ((int32_t) data[2] >> 4);
	adc_Tf = (float)adc_T;

	// Compensation formula from BMP280 Data sheet
	var1 = (((adc_Tf / 16384.0f) - ((float)dig_T1 / 1024.0f)) * (float)dig_T2);
	var2 = ((((adc_Tf / 131072.0f) - ((float)dig_T1 / 8192.0f)) * ((adc_Tf / 131072.0f) - ((float)dig_T1 / 8192.0f))) * (float)dig_T3);

	t_fine = var1 + var2;

	T = t_fine / 5120.0f;											// final temperature in degree Celsius
	return T;
}
