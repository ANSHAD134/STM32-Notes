#include <stdint.h>
#include <stdio.h>
#include <string.h>

#include "stm32f446xx.h"
#include "stm32f446xx_gpio_driver.h"
#include "stm32f446xx_rcc_driver.h"
#include "stm32f446xx_usart_driver.h"
#include "stm32f446xx_low_power.h"

/*--------Global variables-------*/
volatile uint8_t button_event = 0;
volatile uint8_t wake_flag = 0;
/* USER CODE BEGIN PV */
USART_Handle_t USART2Handle;
/* USER CODE END PV */
void delay(void);
int main(void)
{
    PWR_PCLK_EN();

    /* USER CODE BEGIN 1 */
    GPIO_Handle_t GpioLed, GpioBtn;

    // Configure LED (PB5)
    GPIO_PeriClockControl(GPIOB, ENABLE);

    GpioLed.pGPIOx = GPIOB;
    GpioLed.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_5;
    GpioLed.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    GpioLed.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    GpioLed.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
    GpioLed.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

    GPIO_Init(&GpioLed);
    GPIO_WriteToOutputPin(GPIOB, GPIO_PIN_NO_5, GPIO_PIN_RESET);

    // Configure Button (PC13 External)
    GPIO_PeriClockControl(GPIOC, ENABLE);

    GpioBtn.pGPIOx = GPIOC;
    GpioBtn.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_13;
    GpioBtn.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_IN;
    GpioBtn.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    GpioBtn.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_NO_PUPD;

    GPIO_Init(&GpioBtn);

    // Configure the GPIO port selection in SYSCFG_EXTICR
    uint8_t temp1 =  GPIO_PIN_NO_13 / 4;
    uint8_t temp2 =  GPIO_PIN_NO_13 % 4;
    uint8_t portcode = GPIO_BASEADDR_TO_CODE(GPIOC);
    SYSCFG_PCLK_EN();
    SYSCFG->EXTICR[temp1] = portcode << (temp2 * 4);

    /* Enable EXTI2 interrupt */
    EXTI->IMR  |= (1 << GPIO_PIN_NO_13);								// Unmask EXTI line 0 to enable interrupt
    EXTI->RTSR &= ~(1 << GPIO_PIN_NO_13);								// Disable rising edge trigger for EXTI line 0
    EXTI->FTSR |= (1 << GPIO_PIN_NO_13);								// Enable falling edge trigger for EXTI line 0

    /* Clear pending flag */
    EXTI->PR |= (1 << GPIO_PIN_NO_13);									// Clear pending flag for EXTI line 0

    /* -------- NVIC Configuration -------- */
    GPIO_IRQInterruptConfig(IRQ_NO_EXTI15_10,ENABLE);					// Enable EXTI0 interrupt
    GPIO_IRQPriorityConfig(IRQ_NO_EXTI15_10, NVIC_IRQ_PRI5);			// Set EXTI0 interrupt priority to 5

    /* -------- USART Debug Init -------- */
    GPIO_Handle_t GpioUartTx;

    /* Enable GPIOA clock */
    GPIO_PeriClockControl(GPIOA, ENABLE);

    /* PA2 → USART2_TX */
    GpioUartTx.pGPIOx = GPIOA;
    GpioUartTx.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_2;
    GpioUartTx.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_ALTFN;
    GpioUartTx.GPIO_PinConfig.GPIO_PinAltFunMode = 7;   				// AF7 = USART2
    GpioUartTx.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    GpioUartTx.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
    GpioUartTx.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PIN_PU;

    GPIO_Init(&GpioUartTx);


    USART2Handle.pUSARTx = USART2;										// Select USART2 peripheral

    /* Configure USART parameters */
    USART2Handle.USART_Config.USART_Baud           = USART_STD_BAUD_115200;      					// Baud rate
    USART2Handle.USART_Config.USART_Mode           = USART_MODE_ONLY_TX;         					// Transmit only
    USART2Handle.USART_Config.USART_WordLength     = USART_WORDLEN_8BITS;        					// 8-bit data
    USART2Handle.USART_Config.USART_ParityControl  = USART_PARITY_DISABLE;       					// No parity
    USART2Handle.USART_Config.USART_NoOfStopBits   = USART_STOPBITS_1;           					// 1 stop bit
    USART2Handle.USART_Config.USART_HWFlowControl  = USART_HW_FLOW_CTRL_NONE;    					// No flow control

    /* Enable USART peripheral clock */
    USART_PeriClockControl(USART2, ENABLE);

    /* Initialize USART with above settings */
    USART_Init(&USART2Handle);

    /* Enable USART peripheral */
    USART_PeripheralControl(USART2, ENABLE);

    uint8_t msg_stop[] = "Entering STOP mode\r\n";
    uint8_t msg_wake[] = "Wake-up interrupt occurred\r\n";
    /* USER CODE END 1 */

while (1)
{
	if (wake_flag == 0)
	{
		GPIO_WriteToOutputPin(GPIOB, GPIO_PIN_NO_5, GPIO_PIN_RESET);

		USART_SendData(&USART2Handle, msg_stop, strlen((char*)msg_stop));

		USART_PeripheralControl(USART2, DISABLE);
		USART_PeriClockControl(USART2, DISABLE);

		Enter_Stop_Mode();													// Enter low power mode

		SystemClock_ReConfig();												// Restore clock after STOP
		PWR_ClearWakeUpFlag();

        USART_PeriClockControl(USART2, ENABLE);
        USART_PeripheralControl(USART2, ENABLE);

        wake_flag = 1;
	}

	if(button_event)
	{
		button_event = 0;

		if(wake_flag == 1)
		{
			GPIO_WriteToOutputPin(GPIOB, GPIO_PIN_NO_5, GPIO_PIN_SET);
			USART_SendData(&USART2Handle, msg_wake, strlen((char*)msg_wake));
		}
		else
		{
			GPIO_WriteToOutputPin(GPIOB, GPIO_PIN_NO_5, GPIO_PIN_RESET);
		}
		delay();
	}
}
}


/* -------- EXTI Interrupt Handler -------- */
void EXTI15_10_IRQHandler(void)
{
    if (EXTI->PR & (1 << GPIO_PIN_NO_13))
    {
        EXTI->PR |= (1 << GPIO_PIN_NO_13);   					// Clear pending bit
        button_event = 1;
        wake_flag ^= 1;
    }
}

/* ---------------- Simple delay ---------------- */
void delay(void)
{
    for (uint32_t i = 0; i < 300000; i++);
}
