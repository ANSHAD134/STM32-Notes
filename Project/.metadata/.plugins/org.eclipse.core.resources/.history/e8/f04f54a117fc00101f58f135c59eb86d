#include <stdint.h>
#include <stdio.h>
#include <string.h>

#include "stm32f446xx.h"
#include "stm32f446xx_gpio_driver.h"
#include "stm32f446xx_rcc_driver.h"
#include "stm32f446xx_usart_driver.h"
#include "stm32f446xx_low_power.h"

/*--------Global variables-------*/
volatile uint8_t wake_flag = 0;

/* USER CODE BEGIN PV */
#define BTN_PRESSED		 0 								// Button is active low on Nucleo
/* USER CODE END PV */

int main(void)
{
    PWR_PCLK_EN();

    /* USER CODE BEGIN 1 */
    GPIO_Handle_t GpioLed, GpioBtn;

    // Configure LED (PB0)
    GpioLed.pGPIOx = GPIOB;
    GpioLed.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_3;
    GpioLed.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_OUT;
    GpioLed.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    GpioLed.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
    GpioLed.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PIN_PU;

    // Configure Button (PC0 External)
    GpioBtn.pGPIOx = GPIOC;
    GpioBtn.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_0;
    GpioBtn.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_IN;
    GpioBtn.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_FAST;
    GpioBtn.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PIN_PU;

    // Enable clocks
    GPIO_PeriClockControl(GPIOB, ENABLE);
    GPIO_PeriClockControl(GPIOC, ENABLE);

    // Initialize pins
    GPIO_Init(&GpioLed);
    GPIO_Init(&GpioBtn);

    // Configure the GPIO port selection in SYSCFG_EXTICR
    uint8_t temp1 = GpioBtn.GPIO_PinConfig.GPIO_PinNumber / 4;
    uint8_t temp2 = GpioBtn.GPIO_PinConfig.GPIO_PinNumber % 4;
    uint8_t portcode = GPIO_BASEADDR_TO_CODE(GPIOC);
    SYSCFG_PCLK_EN();
    SYSCFG->EXTICR[temp1] = portcode << (temp2 * 4);

    /* Enable EXTI0 interrupt */
    EXTI->IMR  |= (1 << GPIO_PIN_NO_0);								// Unmask EXTI line 0 to enable interrupt
    EXTI->RTSR &= ~(1 << GPIO_PIN_NO_0);							// Disable rising edge trigger for EXTI line 0
    EXTI->FTSR |= (1 << GPIO_PIN_NO_0);								// Enable falling edge trigger for EXTI line 0

    /* Clear pending flag */
    EXTI->PR |= (1 << GPIO_PIN_NO_0);								// Clear pending flag for EXTI line 0

    /* -------- NVIC Configuration -------- */
    GPIO_IRQInterruptConfig(IRQ_NO_EXTI0,ENABLE);					// Enable EXTI0 interrupt
    GPIO_IRQPriorityConfig(IRQ_NO_EXTI0, NVIC_IRQ_PRI5);			// Set EXTI0 interrupt priority to 5

    /* -------- USART Debug Init -------- */
    USART_Handle_t usart;

    usart.pUSARTx = USART2;											// Select USART2 peripheral

    /* Configure USART parameters */
    usart.USART_Config.USART_Baud           = USART_STD_BAUD_115200;      					// Baud rate
    usart.USART_Config.USART_Mode           = USART_MODE_ONLY_TX;         					// Transmit only
    usart.USART_Config.USART_WordLength     = USART_WORDLEN_8BITS;        					// 8-bit data
    usart.USART_Config.USART_ParityControl  = USART_PARITY_DISABLE;       					// No parity
    usart.USART_Config.USART_NoOfStopBits   = USART_STOPBITS_1;           					// 1 stop bit
    usart.USART_Config.USART_HWFlowControl  = USART_HW_FLOW_CTRL_NONE;    					// No flow control

    /* Enable USART peripheral clock */
    USART_PeriClockControl(USART2, ENABLE);

    /* Initialize USART with above settings */
    USART_Init(&usart);

    /* Enable USART peripheral */
    USART_PeripheralControl(USART2, ENABLE);

    /* USER CODE END 1 */

while (1)
{
	uint8_t pTxBuffer[] = "Entering Stop mode\r\n";
	uint32_t len = strlen((char *)pTxBuffer);
	USART_SendData(USART_Handle_t *usart, *pTxBuffer, len);

	Enter_Stop_Mode();									// Enter low power mode

	SystemClock_ReConfig();								// Restore clock after STOP

	if (GPIO_ReadFromInputPin(GPIOC, GPIO_PIN_NO_0) == BTN_PRESSED)
	{
		wake_flag = 0;   								// Clear flag

		GPIO_ToggleOutputPin(GPIOB, GPIO_PIN_NO_3);		//  LED ON (PB3)

		uint8_t pTxBuffer[] = "Wake-up interrupt occurred\r\n";
		uint32_t len = strlen((char *)pTxBuffer);
		USART_SendData(USART_Handle_t *usart, pTxBuffer, len);
	}
}
}


