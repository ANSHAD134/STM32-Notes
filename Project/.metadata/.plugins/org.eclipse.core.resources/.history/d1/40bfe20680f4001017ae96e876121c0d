#include <stdint.h>
#include <stdio.h>

#include "stm32f446xx.h"
#include "stm32f446xx_gpio_driver.h"
#include "stm32f446xx_rcc_driver.h"
#include "stm32f446xx_usart_driver.h"
#include "stm32f446xx_low_power.h"

/*--------Global variables-------*/
volatile uint8_t wake_flag = 0;

/* USER CODE BEGIN PV */
char msg[100];
/* USER CODE END PV */

int main(void)
{
    GPIOA_PCLK_EN();
    GPIOD_PCLK_EN();
    SYSCFG_PCLK_EN();
    PWR_PCLK_EN();

/* Initialize all configured peripherals */
    GPIO_Init();
    USART_Init();

    /* USER CODE BEGIN 1 */
    /* LED: PD12 OUTPUT */
    GPIOD->MODER &= ~(0x3 << (GPIO_PIN_NO_12 * 2));		// Clear mode bits for pin 12
    GPIOD->MODER |=  (1 << (GPIO_PIN_NO_12 * 2));		// Set pin 12 as output

    /* Button: PA0 INPUT */
    GPIOA->MODER &= ~(0x3 << (GPIO_PIN_NO_0 * 2));		// Clear mode bits for pin 0 (set as input)
    GPIOA->PUPDR &= ~(0x3 << (GPIO_PIN_NO_0 * 2)); 		// No pull

    SYSCFG->EXTICR[0] &= ~(0xF << 0);					// Clear EXTI0 bits

    /* Enable EXTI0 interrupt */
    EXTI->IMR  |= (1 << 0);								// Unmask EXTI line 0 to enable interrupt
    EXTI->RTSR |= (1 << 0);								// Enable rising edge trigger for EXTI line 0
    EXTI->FTSR &= ~(1 << 0);							// Disable falling edge trigger for EXTI line 0

    /* Clear pending flag */
    EXTI->PR |= (1 << 0);								// Clear pending flag for EXTI line 0

    /* -------- NVIC Configuration -------- */
    GPIO_IRQInterruptConfig(EXTI,ENABLE);
    GPIO_IRQPriorityConfig(EXTI, 5);
    /* USER CODE END 1 */

while (1)
{
	char msg[] = "Entering STOP mode\r\n";
	USART_SendData(&USART1_Handle,(uint8_t *)msg,sizeof(msg) - 1);

	Enter_Stop_Mode();									// Enter low power mode

	SYSCFG_PCLK_EN();									// Restore clock after STOP

	if (Wake_flag = 0)
	{
		GPIOD->ODR ^= (1 << 12);				 		// Toggle LED (PD12)

		char msg[] = "Wake-up interrupt occurred\r\n";
		USART_SendData(&USART1_Handle,(uint8_t *)msg,sizeof(msg) - 1);
	}
}
