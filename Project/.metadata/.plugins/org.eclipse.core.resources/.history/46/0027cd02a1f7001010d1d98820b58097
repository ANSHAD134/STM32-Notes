
#include "stm32f446xx.h"
#include "stm32f446xx_low_power.h"

#define __WFI

void Enter_Stop_Mode(void)
{
	 PWR->CR &= ~(1 << 1);     						// Clear PDDS bit

	/* Low power regulator ON */
	PWR->CR |= (1 << 0);

	__WFE();   // Wait For Interrupt
}

/*********************************************************************
 * @fn                - PWR_ControlLowPowerRegulator
 *
 * @brief             - Enables or disables low power regulator in STOP mode
 *
 * @param[in]         - Enable: ENABLE or DISABLE
 *
 * @return            - none
 *
 * @Note              - PWR peripheral clock must be enabled before calling
 */
void PWR_ControlLowPowerRegulator(uint8_t Enable)
{
    if (Enable == ENABLE)
    {
        PWR->CR |= (1 << 0);   // LPDS bit set
    }
    else
    {
        PWR->CR &= ~(1 << 0);  // LPDS bit clear
    }
}

/*********************************************************************
 * @fn                - PWR_ClearWakeUpFlag
 *
 * @brief             - Clears the wake-up flag after exit from low power mode
 *
 * @param[in]         - none
 *
 * @return            - none
 *
 * @Note              - Should be called after wake-up
 */
void PWR_ClearWakeUpFlag(void)
{
    PWR->CR |= (1 << 2);   // CWUF bit
}

/* -------- Clock Restore After STOP -------- */
void SystemClock_ReConfig(void)
{
	/* Enable HSI */
	RCC->CR |= (1 << 0);
	while (!(RCC->CR & (1 << 1)));

	/* Select HSI as system clock */
	RCC->CFGR &= ~(3 << 0);
}

