#include "stm32f446xx.h"
#define ADC_PIN	    0

void ADC1_Init(void)
{
    RCC->AHB1ENR |= (1<<0);
    RCC->APB2ENR |= (1<<8);

    GPIOA->MODER |= (3 << (ADC_PIN * 2));
    GPIOA->PUPDR &= ~(3 << (ADC_PIN * 2));

    ADC1->CR2 = 0;
    ADC1->CR1 = 0;
    ADC1->CR2 |= (1 << 1);   // Continuous
    ADC1->SQR1 = 0;
    ADC1->SQR3 = 0;
    ADC1->SMPR2 |= (3 << 0);

    ADC1->CR2 |= (1 << 0);   // ADC ON
    ADC1->CR2 |= (1 << 30);  // Start conversion
}

