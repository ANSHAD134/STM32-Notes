#include "stm32f446xx.h"
#include <stdio.h>
#include "LM35.h"
#define ADC_PIN	    0

void ADC_init(void)
{
		RCC->AHB1ENR |= (1<<0);									// Enable GPIOA Clock
		RCC->APB2ENR |= (1<<8);									// Enable ADC1 Clock

		GPIOA->MODER &= ~(0x3 << (ADC_PIN*2));					// Clear mode bits for PA0
		GPIOA->MODER |= (0x3 << (ADC_PIN*2));					// Set PA0 as Analog Mode
		GPIOA->PUPDR &= ~(0x3 << (ADC_PIN*2));					// No pull-up/pull-down for PA0
}
uint16_t Read_ADC(void)
{
	//ADC REGISTERS
	    ADC1->CR2 &= ~(1 << 0);								// Disable ADC conversion and go to power down mode
	    ADC1->CR1 &= ~(3 << 24);							// Set 12-bit (minimum 15 ADCCLK cycles)
	    ADC1->CR2 &= ~(1 << 11);							// Set Right alignment
	    ADC1->CR2 |= (1 << 1);								// Set Continuous conversion mode
	    ADC1->SQR1 = 0;										// Channel 0 is first conversion
	    ADC1->SQR3 = 0;										// Only 1 conversion
	    ADC1->SMPR2 |= (3 << 0);							// Channel 0 sampling time = 56 cycles
	    ADC1->CR2 |= (1 << 0);								// Enable ADC
	    ADC1->CR2 |= (1 << 30);								// Start conversion
}
